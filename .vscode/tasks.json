{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pneumaris: dev",
      "type": "shell",
      "command": "npm run dev -- --port 4321",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": "Local\\s+http://localhost:4321/"
        }
      }
    }
  ]
}
