---
import Layout from "../layouts/Layout.astro";
import { albums } from "../data/releases";
import { Icon } from "astro-icon/components";
import { SITE_URL } from "../config/site";

const featured = albums[0];
const featuredUrl = `/music/#${featured.title.toLowerCase().replaceAll(" ", "-")}`;

const pageTitle = "Reverie | Pneumaris";
const pageDescription =
	"Reverie, the new 18-track album from Pneumaris. Out now on Spotify, Apple Music, and SoundCloud.";
const canonicalUrl = `${SITE_URL}/`;
const socialImageUrl = `${SITE_URL}/images/reverie-social.jpg`;
const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${SITE_URL}/#website`,
			url: canonicalUrl,
			name: "Pneumaris",
			description: pageDescription,
			inLanguage: "en",
		},
		{
			"@type": "MusicGroup",
			"@id": `${SITE_URL}/#musicgroup`,
			url: canonicalUrl,
			name: "Pneumaris",
			description: pageDescription,
			image: `${SITE_URL}/images/og-image.jpg`,
			sameAs: [
				"https://soundcloud.com/pneumaris",
				"https://www.youtube.com/@Pneumaris",
				"https://www.tiktok.com/@pneumaris",
				"https://x.com/pneumarisband",
				"https://www.instagram.com/pneumaris/",
				"https://www.facebook.com/profile.php?id=61589446647657",
			],
		},
	],
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
	socialImageUrl={socialImageUrl}
	socialImageAlt="Reverie album artwork by Pneumaris"
	structuredData={structuredData}
	active="home"
>

<main id="main">
	<section class="release-hero" aria-labelledby="release-title">
		<div class="release-copy">
			<p class="release-intro">The new album from Pneumaris · Out now</p>
			<h1 id="release-title">{featured.title}</h1>
			<p class="release-description">{featured.summary}</p>
			<nav class="hero-actions" aria-label={`Listen to ${featured.title}`}>
				<p class="listen-label">Listen on</p>
				{featured.spotifyUrl && <a class="streaming-link" href={featured.spotifyUrl} target="_blank" rel="noopener noreferrer"><Icon name="simple-icons:spotify" aria-hidden="true" />Spotify</a>}
				{featured.appleMusicUrl && <a class="streaming-link" href={featured.appleMusicUrl} target="_blank" rel="noopener noreferrer"><Icon name="simple-icons:applemusic" aria-hidden="true" />Apple Music</a>}
				<a class="streaming-link" href={featured.albumUrl} target="_blank" rel="noopener noreferrer"><Icon name="simple-icons:soundcloud" aria-hidden="true" />SoundCloud</a>
			</nav>
			<p class="release-explore"><a class="text-link" href={featuredUrl}>Explore all {featured.tracks.length} tracks</a></p>
		</div>
		<a class="release-art" href={featuredUrl} aria-label={`Explore ${featured.title}`}>
			<img src={featured.artwork} width="1200" height="1200" alt="Reverie cover: a sleeping stone face, fractured with gold, beneath ruined arches and a star-filled sky" fetchpriority="high" decoding="async" />
		</a>
	</section>

	<section class="catalogue-section" aria-labelledby="catalogue-title">
		<div class="section-heading">
			<h2 id="catalogue-title">Before Reverie</h2>
			<a class="text-link" href="/music/">The full discography</a>
		</div>
		<div class="catalogue-grid">
			{albums.slice(1, 4).map((album) => (
				<a class="catalogue-release" href={`/music/#${album.title.toLowerCase().replaceAll(" ", "-")}`}>
					<img src={album.artwork} width="500" height="500" alt={`${album.title} cover art`} loading="lazy" decoding="async" />
					<div><h3>{album.title}</h3><p>{album.type}, {album.year}</p></div>
				</a>
			))}
		</div>
	</section>

	<section class="intro-section" aria-labelledby="intro-title">
		<div class="intro-text">
			<h2 id="intro-title">Between silence<br />and fury.</h2>
			<p>Pneumaris is an atmospheric project that dwells in the space between silence and fury, conjuring crushing riffs, haunting melodies, and an air of the esoteric.</p>
			<p>Each release is an invitation to descend into the dark, where the weight of the music hits as hard as it haunts.</p>
			<a class="text-link" href="/about/">Meet the project</a>
		</div>
		<img class="intro-logo" src="/images/intro-emblem-v1.webp" width="640" height="640" alt="Pneumaris wordmark across a shrouded figure beneath a cracked stone halo" loading="lazy" decoding="async" />
	</section>

	<section class="extras-section" aria-labelledby="extras-title">
		<img src="/images/wallpaper-preview.webp" width="1280" height="536" alt="An eclipsed moon above a gothic skyline" loading="lazy" decoding="async" />
		<div>
			<h2 id="extras-title">Take the atmosphere with you.</h2>
			<p>Two Pneumaris wallpapers for your desktop. Free to download.</p>
			<a class="text-link" href="/extras/">Explore extras</a>
		</div>
	</section>
</main>

<style>
	.release-hero { max-width: 1440px; margin: auto; padding: clamp(2.5rem, 5vw, 5rem) var(--gutter) clamp(4rem, 7vw, 6rem); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); }
	.release-copy { min-width: 0; }
	.release-intro { color: var(--ink-soft); font-size: 1rem; margin-bottom: 1.25rem; }
	.release-copy h1 { font-size: clamp(3.5rem, 7.4vw, 7rem); line-height: 1.1; letter-spacing: -0.035em; color: var(--gold-bright); }
	.release-description { max-width: 49ch; margin: 1.5rem 0 2rem; }
	.hero-actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; width: 100%; max-width: 32rem; }
	.listen-label { grid-column: 1 / -1; color: var(--ink-soft); font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; }
	.streaming-link { display: flex; align-items: center; justify-content: center; gap: 0.6rem; min-height: 52px; padding: 0.75rem 0.5rem; border: 1px solid var(--line); border-radius: 2px; background: var(--surface); color: var(--ink); font-size: 0.9rem; font-weight: 500; }
	.streaming-link svg { width: 1.25rem; height: 1.25rem; flex-shrink: 0; color: var(--gold); }
	.streaming-link:hover, .streaming-link:focus-visible { border-color: var(--gold); background: var(--surface-raised); color: var(--gold-bright); }
	.streaming-link:active { background: var(--surface-strong); }
	.release-art { display: block; }
	.release-art img { display: block; width: 100%; height: auto; object-fit: contain; }
	.release-explore { margin-top: 1rem; }
	.catalogue-section, .intro-section, .extras-section { max-width: var(--content-width); margin: 0 auto; }
	.catalogue-section { padding: 0 var(--gutter) clamp(4rem, 7vw, 6rem); }
	.section-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 1.75rem; }
	.section-heading h2, .intro-text h2, .extras-section h2 { font-size: clamp(1.75rem, 3vw, 2.75rem); line-height: 1.2; letter-spacing: -0.015em; }
	.catalogue-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 3vw, 2.5rem); }
	.catalogue-release { display: block; color: var(--ink); }
	.catalogue-release img { width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; display: block; }
	.catalogue-release h3 { font-size: clamp(1.15rem, 2vw, 1.5rem); color: var(--ink); letter-spacing: 0; margin-top: 1rem; }
	.catalogue-release p { font-size: 1rem; color: var(--ink-soft); margin-top: 0.25rem; }
	.catalogue-release:active img { opacity: 0.8; }
	.intro-section { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 3rem; align-items: center; padding: clamp(3rem, 6vw, 5rem) var(--gutter); background: var(--surface); }
	.intro-text h2 { margin-bottom: 1.5rem; }
	.intro-text p { max-width: 52ch; margin-bottom: 1.1rem; }
	.intro-text .text-link { margin-top: 0.5rem; }
	.intro-logo { width: min(100%, 280px); height: auto; justify-self: center; }
	.extras-section { display: grid; grid-template-columns: 1.2fr 1fr; align-items: center; gap: clamp(2rem, 4vw, 4rem); padding: clamp(3rem, 6vw, 5rem) var(--gutter) 0; }
	.extras-section img { width: 100%; height: auto; display: block; }
	.extras-section p { margin: 1rem 0; max-width: 34ch; }
	@media (hover: hover) { .catalogue-release:hover h3 { color: var(--gold-bright); } }
	@media (max-width: 800px) {
		.release-hero { grid-template-columns: 1fr; gap: 2rem; padding-top: 1.75rem; }
		.release-art { grid-row: 1; max-width: 560px; width: 100%; justify-self: center; }
		.release-copy h1 { font-size: clamp(3.5rem, 14vw, 6rem); }
		.release-intro { margin-bottom: 0.75rem; }
		.release-copy { display: flex; flex-direction: column; }
		.release-copy h1 { margin-bottom: 1.25rem; }
		.hero-actions { order: 1; }
		.release-explore { order: 2; }
		.release-description { order: 3; margin: 1.5rem 0 0; }
		.intro-section { grid-template-columns: 1fr; }
		.intro-logo { width: 180px; }
		.extras-section { grid-template-columns: 1fr; }
	}
	@media (max-width: 480px) {
		.hero-actions { grid-template-columns: 1fr; gap: 0.5rem; }
		.section-heading { flex-direction: column; gap: 0.25rem; }
		.catalogue-grid { grid-template-columns: 1fr; gap: 1.5rem; }
		.catalogue-release { display: grid; grid-template-columns: 112px minmax(0, 1fr); align-items: center; gap: 1.25rem; }
		.catalogue-release h3 { margin: 0; }
	}
</style>
</Layout>
