---
import Layout from "../layouts/Layout.astro";
import ParallaxScene from "../components/ParallaxScene.astro";
import { albums } from "../data/releases";
import { Icon } from "astro-icon/components";
import { SITE_URL } from "../config/site";

const featured = albums[0];
const featuredUrl = `/music/#${featured.title.toLowerCase().replaceAll(" ", "-")}`;

const pageTitle = "Pneumaris | Atmospheric Metal Band";
const pageDescription =
	"Pneumaris is an atmospheric metal band forging crushing riffs, haunting melodies, and dark atmosphere. Stream new music on Spotify, Apple Music, and SoundCloud.";
const canonicalUrl = `${SITE_URL}/`;
const socialImageUrl = `${SITE_URL}/og-image.jpg`;
const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${SITE_URL}/#website`,
			url: canonicalUrl,
			name: "Pneumaris",
			description: pageDescription,
			inLanguage: "en",
		},
		{
			"@type": "MusicGroup",
			"@id": `${SITE_URL}/#musicgroup`,
			url: canonicalUrl,
			name: "Pneumaris",
			description: pageDescription,
			image: socialImageUrl,
			sameAs: [
				"https://soundcloud.com/pneumaris",
				"https://www.youtube.com/@Pneumaris",
				"https://www.tiktok.com/@pneumaris",
				"https://x.com/pneumarisband",
				"https://www.instagram.com/pneumaris/",
				"https://www.facebook.com/profile.php?id=61589446647657",
			],
		},
	],
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
	socialImageUrl={socialImageUrl}
	structuredData={structuredData}
	active="home"
>

<Fragment slot="head">
	<link rel="preload" as="image" href="/hero-environment-v1.webp" fetchpriority="high" />
	<link rel="preload" as="image" href="/hero-character-v1.webp" fetchpriority="high" />
</Fragment>


<main id="main">
	<section aria-label="Pneumaris">
		<ParallaxScene>
			<div class="hero-content">
				<h1>Pneumaris</h1>
				<p class="hero-sub">Atmospheric soundscapes forged<br class="desktop-break" /> from shadow and resonance.</p>
				<div class="hero-actions">
					<a class="button-primary" href="/music/"><Icon name="lucide:play" aria-hidden="true" />Explore the music</a>
					<a class="text-link" href="/about/">Inside Pneumaris</a>
				</div>
			</div>
		</ParallaxScene>
	</section>

	<section class="featured-section" aria-labelledby="featured-title">
		<a class="featured-art" href={featuredUrl} aria-label={`Explore ${featured.title}`}>
			<img src={featured.artwork} width="960" height="960" alt={`${featured.title} album artwork`} loading="lazy" decoding="async" />
		</a>
		<div class="featured-copy">
			<p class="release-note">Latest release</p>
			<h2 id="featured-title">{featured.title}</h2>
			<p class="release-meta">{featured.type} &middot; {featured.year} &middot; {featured.tracks.length} tracks</p>
			<p class="featured-description">{featured.summary ?? featured.description}</p>
			<a class="text-link" href={featuredUrl}>Discover the release</a>
			<nav class="release-streams" aria-label={`Listen to ${featured.title}`}>
				{featured.spotifyUrl && <a href={featured.spotifyUrl} target="_blank" rel="noopener noreferrer"><Icon name="simple-icons:spotify" aria-hidden="true" />Spotify</a>}
				{featured.appleMusicUrl && <a href={featured.appleMusicUrl} target="_blank" rel="noopener noreferrer"><Icon name="simple-icons:applemusic" aria-hidden="true" />Apple Music</a>}
				<a href={featured.albumUrl} target="_blank" rel="noopener noreferrer"><Icon name="simple-icons:soundcloud" aria-hidden="true" />SoundCloud</a>
			</nav>
		</div>
	</section>

	<section class="intro-section" aria-labelledby="intro-title">
		<div class="intro-text">
			<h2 id="intro-title">Between silence<br />and fury.</h2>
			<p>Pneumaris is an atmospheric project that dwells in the space between silence and fury, conjuring crushing riffs, haunting melodies, and an air of the esoteric.</p>
			<p>Each release is an invitation to descend into the dark, where the weight of the music hits as hard as it haunts.</p>
			<a class="text-link" href="/about/">Meet the project</a>
		</div>
		<img class="intro-logo" src="/logo-circle.webp" width="640" height="640" alt="Pneumaris circular emblem" loading="lazy" decoding="async" />
	</section>

	<section class="extras-section" aria-labelledby="extras-title">
		<img src="/wallpaper-preview.webp" width="1280" height="536" alt="An eclipsed moon above a gothic skyline" loading="lazy" decoding="async" />
		<div>
			<h2 id="extras-title">Take the atmosphere with you.</h2>
			<p>A Pneumaris wallpaper for your desktop. Free to download.</p>
			<a class="text-link" href="/extras/">Explore extras</a>
		</div>
	</section>
</main>

<style>
	.hero-content { position: relative; width: 100%; max-width: 1360px; margin: 0 auto; padding: 7rem var(--gutter) 4.5rem; }
	.hero-content h1 { font-size: clamp(2.75rem, 8.5vw, 7.5rem); font-weight: 500; letter-spacing: 0.055em; line-height: 1.1; color: #ead7af; text-shadow: 0 2px 32px rgba(0,0,0,0.6); }
	.hero-sub { font-size: clamp(1rem, 1.6vw, 1.2rem); font-weight: 400; color: var(--ink); margin: 1.4rem 0 2rem; line-height: 1.7; }
	.hero-actions { display: flex; flex-wrap: wrap; gap: 1.75rem; align-items: center; }
	.featured-section, .intro-section, .extras-section { max-width: var(--content-width); margin: 0 auto; }
	.featured-section { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; padding: clamp(3rem, 7vw, 6rem) var(--gutter); }
	.featured-art { display: block; max-width: 480px; }
	.featured-art img { display: block; width: 100%; height: auto; box-shadow: 0 18px 70px rgba(0,0,0,0.4); }
	.release-note { color: var(--gold); font-size: 0.9rem; margin-bottom: 0.75rem; }
	.featured-copy h2 { font-size: clamp(2.5rem, 4.5vw, 4.25rem); letter-spacing: 0.025em; }
	.release-meta { color: var(--ink-soft); font-size: 0.85rem; margin: 0.6rem 0 1.5rem; }
	.featured-description { color: var(--ink); max-width: 48ch; margin-bottom: 1.5rem; }
	.release-streams { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
	.release-streams a { display: inline-flex; gap: 0.5rem; align-items: center; color: var(--ink-soft); font-size: 0.85rem; min-height: 44px; }
	.release-streams a:hover { color: var(--gold-bright); }
	.release-streams svg { width: 1.1rem; height: 1.1rem; }
	.intro-section { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 3rem; align-items: center; padding: clamp(3rem, 6vw, 5rem) var(--gutter); border-top: 1px solid var(--line); }
	.intro-text h2 { font-size: clamp(2rem, 3.5vw, 3rem); letter-spacing: 0.025em; line-height: 1.3; margin-bottom: 1.5rem; }
	.intro-text p { color: var(--ink-soft); max-width: 52ch; margin-bottom: 1.1rem; }
	.intro-text .text-link { margin-top: 0.5rem; }
	.intro-logo { width: min(100%, 300px); height: auto; justify-self: center; opacity: 0.8; }
	.extras-section { position: relative; margin-top: 2rem; overflow: hidden; }
	.extras-section img { width: 100%; height: 360px; object-fit: cover; display: block; opacity: 0.45; }
	.extras-section::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(8,7,6,0.8), transparent); pointer-events: none; }
	.extras-section > div { position: absolute; inset: 0; z-index: 1; padding: 2rem var(--gutter); display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
	.extras-section h2 { font-size: clamp(1.7rem, 3vw, 2.5rem); letter-spacing: 0.02em; max-width: 20ch; }
	.extras-section p { margin: 1rem 0 1.5rem; max-width: 34ch; }
	@media (max-width: 600px) {
		.hero-content { padding-bottom: 3rem; }
		.hero-content h1 { font-size: clamp(2.25rem, 9.3vw, 3.75rem); letter-spacing: 0.015em; }
		.hero-sub { max-width: 28ch; }
		.desktop-break { display: none; }
		.hero-actions { gap: 1rem; }
		.featured-section { grid-template-columns: 1fr; gap: 2rem; }
		.featured-art { width: 85%; }
		.intro-section { grid-template-columns: 1fr; }
		.intro-logo { width: 180px; }
		.extras-section { margin-inline: var(--gutter); }
	}
</style>
</Layout>
