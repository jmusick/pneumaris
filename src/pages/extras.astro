---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { SITE_URL } from "../config/site";

const pageTitle = "Extras | Pneumaris";
const pageDescription = "Free downloads for Pneumaris fans: two desktop wallpapers in 3440 x 1440.";
const canonicalUrl = `${SITE_URL}/extras/`;
const wallpapers = [
	{
		title: "Eclipsed skyline",
		preview: "/images/wallpaper-preview.webp",
		alt: "A robed figure facing an eclipsed moon over a gothic spire skyline, with the Pneumaris wordmark",
		filename: "pneumaris-wallpaper-3440x1440.png",
	},
	{
		title: "Moonlit observatory",
		preview: "/images/wallpaper-2-preview.webp",
		alt: "A golden armillary sphere inside a ruined gothic observatory above a dark sea, with a crescent moon and the Pneumaris wordmark",
		filename: "pneumaris-wallpaper-2-3440x1440.png",
	},
];
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
	active="extras"
>

<style>

	.content {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 3rem var(--gutter) 5rem;
		display: grid;
		gap: 3rem;
	}

	.freebie-card {
		border: 1px solid var(--line);
		border-radius: 2px;
		overflow: hidden;
		background: rgba(255, 255, 255, 0.02);
	}

	.freebie-card img {
		display: block;
		width: 100%;
		height: auto;
	}

	.freebie-info {
		padding: 1.6rem clamp(1.1rem, 3vw, 2rem) 2rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.2rem;
	}

	.freebie-info h2 {
		font-size: 1.4rem;
		margin-bottom: 0.35rem;
	}

	.freebie-meta {
		color: var(--ink-soft);
		font-size: 1rem;
	}

	.download-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
		border: 1px solid var(--gold-dim);
		border-radius: 2px;
		min-height: 44px;
		color: var(--ink);
		text-decoration: none;
		font-size: 1rem;
		letter-spacing: 0.03em;
		white-space: nowrap;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.download-button:active { background: var(--surface-raised); }
	.download-button:focus-visible {
		background: rgba(232, 224, 212, 0.08);
		border-color: rgba(232, 224, 212, 0.4);
	}
	@media (hover: hover) {
		.download-button:hover { background: var(--surface-raised); border-color: var(--gold); }
	}
</style>

<main id="main">
	<PageHeader title="Extras" description="A little of the Pneumaris world to take with you." />

	<div class="content">
		{wallpapers.map((wallpaper, index) => (
			<article class="freebie-card" aria-labelledby={`wallpaper-${index + 1}`}>
				<img src={wallpaper.preview} width="1280" height="536" alt={wallpaper.alt}
					loading={index === 0 ? "eager" : "lazy"} decoding="async" />
				<div class="freebie-info">
					<div>
						<h2 id={`wallpaper-${index + 1}`}>{wallpaper.title}</h2>
						<p class="freebie-meta">3440 &times; 1440 PNG</p>
					</div>
					<a class="download-button" href={`/downloads/${wallpaper.filename}`}
						download={wallpaper.filename} aria-label={`Download ${wallpaper.title} wallpaper`}>Download PNG</a>
				</div>
			</article>
		))}
	</div>
</main>

</Layout>
