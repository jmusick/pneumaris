---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { SITE_URL } from "../config/site";

const pageTitle = "About | Pneumaris";
const pageDescription = "About Pneumaris: atmospheric music from the void.";
const canonicalUrl = `${SITE_URL}/about/`;
const socialImageUrl = `${SITE_URL}/og-image.jpg`;
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
	socialImageUrl={socialImageUrl}
	active="about"
>

<style>

			.content {
				max-width: var(--content-width);
				margin: 0 auto;
				padding: 3rem var(--gutter);
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: clamp(2rem, 5vw, 5rem);
				align-items: start;
			}

			.about-text {
				display: flex;
				flex-direction: column;
				gap: 1.4rem;
			}

			.about-text p {
				color: rgba(232, 224, 212, 0.72);
				font-size: 1.05rem;
			}

			.about-image {
				position: sticky;
				top: 8rem;
			}

			.about-image img {
				width: 100%;
				aspect-ratio: 4 / 3;
				object-fit: cover;
				height: auto;
				border-radius: 2px;
				border: 1px solid var(--line);
				filter: brightness(0.88) contrast(1.05);
			}

			@media (max-width: 720px) {
				.content {
					grid-template-columns: 1fr;
				}

				.about-image {
					position: static;
				}
			}
</style>

		<main id="main">
			<PageHeader title="About" description="The breath, the spirit, the space between silence and sound." />

			<div class="content">
				<div class="about-text">
					<p>
						Pneumaris is an atmospheric music project conjured from the spaces
						between silence and sound. The name draws from the ancient concept of
						<em>pneuma</em> (the breath, the spirit, the unseen force that animates all
						things), and from the Latin <em>aris</em>, suggesting both the altar and the air.
					</p>
					<p>
					The music forges itself in the space between extremes, heavy
					enough to crush, haunting enough to linger, driven by the raw
					force of metal and the weight of dark atmosphere.
					</p>
					<p>
						There are no borders between genre, no allegiance to trend.
					Only the pursuit of something darker: riffs that cut, melodies that haunt,
					and an atmosphere that refuses to let go.
					</p>
				</div>
				<div class="about-image">
					<img src="/header.webp" width="1920" height="787" alt="Pneumaris: atmospheric darkness" loading="lazy" decoding="async" />
				</div>
			</div>
		</main>

</Layout>
