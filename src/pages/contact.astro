---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { SITE_URL, TURNSTILE_SITE_KEY } from "../config/site";
import { CONTACT_LIMITS } from "../lib/contact-rules";

const pageTitle = "Contact | Pneumaris";
const pageDescription = "Get in touch with Pneumaris.";
const canonicalUrl = `${SITE_URL}/contact/`;
const socialImageUrl = `${SITE_URL}/og-image.jpg`;

/**
 * `astro dev` uses Cloudflare's documented always-passes test key: the real
 * widget only accepts pneumarisband.com, so it would show an error on
 * localhost. `astro dev` also doesn't serve Pages Functions, so /api/contact
 * 404s there; the page says so. See README "Contact Form" for testing the
 * real endpoint locally.
 */
const TURNSTILE_DEV_TEST_KEY = "1x00000000000000000000AA";
const turnstileSiteKey = import.meta.env.DEV ? TURNSTILE_DEV_TEST_KEY : TURNSTILE_SITE_KEY;
const functionUnavailable = import.meta.env.DEV;
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
	socialImageUrl={socialImageUrl}
	active="contact"
>

	<Fragment slot="head">
		<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=pneumarisTurnstileReady" async defer></script>
	</Fragment>

<style>

			.content {
				max-width: 680px;
				margin: 0 auto;
				padding: 3.5rem var(--gutter);
			}

			.contact-intro {
				color: rgba(232, 224, 212, 0.65);
				font-size: 1.05rem;
				margin-bottom: 2rem;
				line-height: 1.8;
			}

			.contact-form {
				display: grid;
				grid-template-columns: minmax(0, 1fr);
				gap: 1rem;
				margin-bottom: 2rem;
			}

			.form-row {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}

			.form-field {
				min-width: 0;
				display: flex;
				flex-direction: column;
				gap: 0.45rem;
			}

			.form-field label {
				font-family: "Cinzel", serif;
				font-size: 0.85rem;
				letter-spacing: 0.025em;

				color: var(--ink-soft);
			}

			.form-field input,
			.form-field textarea {
				width: 100%;
				background: rgba(22, 15, 10, 0.75);
				border: 1px solid var(--gold-dim);
				border-radius: 2px;
				padding: 0.8rem 0.9rem;
				color: var(--ink);
				font: inherit;
				transition: border-color 180ms ease, box-shadow 180ms ease;
			}

			.form-field textarea {
				min-height: 180px;
				resize: vertical;
			}

			.form-field input:focus,
			.form-field textarea:focus {
				outline: none;
				border-color: var(--gold-bright);
				box-shadow: 0 0 0 2px rgba(184, 154, 106, 0.18);
			}

			.form-field input[aria-invalid="true"],
			.form-field textarea[aria-invalid="true"] {
				border-color: #d4948f;
			}

			.field-error {
				margin: 0;
				font-size: 0.85rem;
				color: #d4948f;
			}

			.dev-note {
				margin: 0;
				font-size: 0.85rem;
				color: var(--ink-soft);
			}

			.contact-submit {
				justify-self: start;
				background: rgba(184, 154, 106, 0.12);
				border: 1px solid var(--gold-dim);
				border-radius: 2px;
				padding: 0.7rem 1.2rem;
				font-family: "Cinzel", serif;
				font-size: 0.78rem;
				letter-spacing: 0.025em;

				color: var(--gold-bright);
				cursor: pointer;
				transition: background 180ms ease, border-color 180ms ease;
			}

			.contact-submit:hover {
				background: rgba(184, 154, 106, 0.2);
				border-color: var(--gold);
			}

			.contact-submit:disabled {
				opacity: 0.6;
				cursor: not-allowed;
			}

			.form-status {
				min-height: 1.4rem;
				font-size: 0.9rem;
				color: var(--ink-soft);
			}

			.form-status.success {
				color: #9ec08f;
			}

			.form-status.error {
				color: #d4948f;
			}

			.form-honeypot {
				display: none;
			}

			.links-list {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.contact-link {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 1.1rem 1.4rem;
				border: 1px solid var(--line);
				border-radius: 2px;
				color: var(--ink-soft);
				font-family: "Cinzel", serif;
				font-size: 0.82rem;
				letter-spacing: 0.025em;

				transition: border-color 180ms ease, color 180ms ease, background 180ms ease;
			}

			.contact-link:hover {
				border-color: var(--gold-dim);
				color: var(--gold-bright);
				background: rgba(184, 154, 106, 0.05);
			}

			.contact-link span {
				opacity: 0.4;
				font-size: 0.9rem;
			}

			@media (max-width: 720px) {
				.form-row {
					grid-template-columns: 1fr;
				}
			}
</style>

		<main id="main">
			<PageHeader title="Contact" description="Booking, press, collaborations, and conversation." />

			<div class="content">
				<p class="contact-intro">
					For booking, press inquiries, collaborations, or anything else, use the form below.
				</p>

				<form id="contact-form" class="contact-form" novalidate>
					<div class="form-row">
						<div class="form-field">
							<label for="name">Name</label>
							<input id="name" name="name" type="text" autocomplete="name" required maxlength={CONTACT_LIMITS.name} aria-describedby="name-error" />
							<p id="name-error" class="field-error" hidden></p>
						</div>
						<div class="form-field">
							<label for="email">Email</label>
							<input id="email" name="email" type="email" autocomplete="email" required maxlength={CONTACT_LIMITS.email} aria-describedby="email-error" />
							<p id="email-error" class="field-error" hidden></p>
						</div>
					</div>

					<div class="form-field">
						<label for="subject">Subject</label>
						<input id="subject" name="subject" type="text" required maxlength={CONTACT_LIMITS.subject} aria-describedby="subject-error" />
						<p id="subject-error" class="field-error" hidden></p>
					</div>

					<div class="form-field">
						<label for="message">Message</label>
						<textarea id="message" name="message" required maxlength={CONTACT_LIMITS.message} aria-describedby="message-error"></textarea>
						<p id="message-error" class="field-error" hidden></p>
					</div>

					<div class="form-honeypot" aria-hidden="true">
						<label for="website">Website</label>
						<input id="website" name="website" type="text" autocomplete="off" tabindex="-1" />
					</div>

					{/*
						Rendered by the script below (api.js loads with render=explicit) so it
						can pick the compact size when the content box is narrower than the
						300px normal widget, as it is at a 320px viewport.
					*/}
					<div id="turnstile-slot" class="turnstile-slot" data-sitekey={turnstileSiteKey}></div>

					<button class="contact-submit" type="submit">Send Message</button>
					<p id="form-status" class="form-status" role="status" aria-live="polite"></p>
					{functionUnavailable && (
						<p class="dev-note">
							Dev server only: Turnstile is using its test key, and <code>astro dev</code> doesn't
							serve <code>/api/contact</code>, so sending fails here. Field validation still works.
						</p>
					)}
				</form>

				<div class="links-list">
					<a
						class="contact-link"
						href="https://soundcloud.com/pneumaris"
						target="_blank"
						rel="noopener noreferrer"
					>
						SoundCloud
						<span>↗</span>
					</a>
				</div>
			</div>
		</main>


		<script>
			import { CONTACT_EMAIL_PATTERN } from "../lib/contact-rules";

			interface Turnstile {
				render(container: HTMLElement, options: Record<string, unknown>): string;
				getResponse(widgetId?: string): string | undefined;
				reset(widgetId?: string): void;
				remove(widgetId: string): void;
			}
			type ContactWindow = Window & { turnstile?: Turnstile; pneumarisTurnstileReady?: () => void };
			const contactWindow = window as ContactWindow;

			type FieldName = "name" | "email" | "subject" | "message";
			const FIELD_NAMES: FieldName[] = ["name", "email", "subject", "message"];
			const LABELS: Record<FieldName, string> = {
				name: "your name",
				email: "your email address",
				subject: "a subject",
				message: "a message",
			};

			const form = document.getElementById("contact-form") as HTMLFormElement | null;
			const statusEl = document.getElementById("form-status") as HTMLElement | null;
			const submitButton = form?.querySelector("button[type='submit']") as HTMLButtonElement | null;
			const slot = document.getElementById("turnstile-slot");
			const setStatusText = (text: string) => {
				if (!statusEl) return;
				statusEl.textContent = text;
				statusEl.className = "form-status error";
			};

			// Turnstile: the 300px "normal" widget when the slot can hold it, otherwise
			// the 150px "compact" one. `flexible` also has a 300px minimum, so it can't
			// fit a narrow phone layout.
			const NORMAL_WIDGET_WIDTH = 300;
			let widgetId: string | undefined;
			const mountTurnstile = () => {
				const turnstile = contactWindow.turnstile;
				if (!slot || !turnstile) return;
				if (widgetId !== undefined) turnstile.remove(widgetId);
				widgetId = turnstile.render(slot, {
					sitekey: slot.dataset.sitekey ?? "",
					theme: "dark",
					// Without this the visitor would only ever see "please wait" on send.
					"error-callback": () => {
						setStatusText("The verification check couldn't load. Please reload the page and try again.");
					},
					size: slot.parentElement && slot.parentElement.clientWidth >= NORMAL_WIDGET_WIDTH ? "normal" : "compact",
				});
			};
			const resetTurnstile = () => {
				if (widgetId !== undefined) contactWindow.turnstile?.reset(widgetId);
			};
			// api.js may finish loading before or after this module runs.
			if (contactWindow.turnstile) mountTurnstile();
			else contactWindow.pneumarisTurnstileReady = mountTurnstile;

			// Rotation or a resize can cross the threshold; rebuild at the right size.
			// That drops any unsent token, and a fresh one follows.
			let lastNormal = (slot?.parentElement?.clientWidth ?? 0) >= NORMAL_WIDGET_WIDTH;
			window.addEventListener("resize", () => {
				const normal = (slot?.parentElement?.clientWidth ?? 0) >= NORMAL_WIDGET_WIDTH;
				if (normal !== lastNormal) {
					lastNormal = normal;
					mountTurnstile();
				}
			});

			if (form && statusEl && submitButton) {
				const fields = Object.fromEntries(
					FIELD_NAMES.map((name) => [name, form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement]),
				) as Record<FieldName, HTMLInputElement | HTMLTextAreaElement>;

				const setStatus = (text: string, state: "" | "success" | "error") => {
					statusEl.textContent = text;
					statusEl.className = state ? `form-status ${state}` : "form-status";
				};

				const showError = (name: FieldName, message: string) => {
					const input = fields[name];
					const error = document.getElementById(`${name}-error`);
					input.setAttribute("aria-invalid", "true");
					if (error) {
						error.textContent = message;
						error.hidden = false;
					}
				};

				const clearError = (name: FieldName) => {
					const error = document.getElementById(`${name}-error`);
					fields[name].removeAttribute("aria-invalid");
					if (error) {
						error.textContent = "";
						error.hidden = true;
					}
				};

				/** The error for a field's trimmed value, or null when it's valid. */
				const fieldError = (name: FieldName): string | null => {
					const input = fields[name];
					const value = input.value.trim();
					if (!value) return `Please enter ${LABELS[name]}.`;
					if (name === "email" && !CONTACT_EMAIL_PATTERN.test(value)) return "Please enter a valid email address.";
					if (input.maxLength > 0 && value.length > input.maxLength) {
						const label = name.charAt(0).toUpperCase() + name.slice(1);
						return `${label} must be ${input.maxLength} characters or fewer.`;
					}
					return null;
				};

				/** Marks every invalid field and returns them in form order. */
				const validate = (): FieldName[] => {
					const invalid: FieldName[] = [];
					for (const name of FIELD_NAMES) {
						const error = fieldError(name);
						if (error) {
							showError(name, error);
							invalid.push(name);
						} else {
							clearError(name);
						}
					}
					return invalid;
				};

				// Once a field has been flagged, clear its error as soon as it's fixed.
				for (const name of FIELD_NAMES) {
					fields[name].addEventListener("input", () => {
						if (fields[name].getAttribute("aria-invalid") === "true" && !fieldError(name)) clearError(name);
					});
				}

				form.addEventListener("submit", async (event) => {
					event.preventDefault();

					const invalid = validate();
					if (invalid.length > 0) {
						setStatus(
							invalid.length === 1 ? "Please fix the highlighted field." : `Please fix the ${invalid.length} highlighted fields.`,
							"error",
						);
						fields[invalid[0]].focus();
						return;
					}

					const captchaToken = widgetId !== undefined ? contactWindow.turnstile?.getResponse(widgetId) ?? "" : "";
					if (!captchaToken) {
						setStatus("Please wait a moment for the verification check, then send again.", "error");
						return;
					}

					submitButton.disabled = true;
					setStatus("Sending...", "");

					const formData = new FormData(form);
					try {
						const response = await fetch("/api/contact", {
							method: "POST",
							headers: { "Content-Type": "application/json", Accept: "application/json" },
							body: JSON.stringify({
								name: fields.name.value.trim(),
								email: fields.email.value.trim(),
								subject: fields.subject.value.trim(),
								message: fields.message.value.trim(),
								website: String(formData.get("website") || ""),
								captchaToken,
							}),
						});
						const result = (await response.json().catch(() => null)) as
							| { message?: string; error?: string; field?: string }
							| null;

						if (!response.ok) {
							const field = FIELD_NAMES.find((name) => name === result?.field);
							// What the visitor typed stays in the form so they can try again.
							if (field && result?.error) {
								showError(field, result.error);
								fields[field].focus();
								setStatus("Please fix the highlighted field.", "error");
							} else {
								setStatus(result?.error ?? "Unable to send your message right now.", "error");
							}
							return;
						}

						form.reset();
						FIELD_NAMES.forEach(clearError);
						setStatus(result?.message ?? "Message sent successfully.", "success");
					} catch {
						setStatus("Could not reach the server. Please try again in a moment.", "error");
					} finally {
						submitButton.disabled = false;
						// Turnstile tokens are single-use; reset so a retry (or a second
						// message) doesn't submit an already-spent token.
						resetTurnstile();
					}
				});
			}
		</script>
</Layout>
