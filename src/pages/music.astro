---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import TrackPlayer from "../components/TrackPlayer.astro";
import { Icon } from "astro-icon/components";
import { SITE_URL } from "../config/site";

import { albums } from "../data/releases";

const pageTitle = "Music | Pneumaris";
const pageDescription = "Listen to Pneumaris albums and explore the artwork for every track.";
const canonicalUrl = `${SITE_URL}/music/`;
const socialImageUrl = `${SITE_URL}/og-image.jpg`;

const fullArtwork = (src: string) => src.replace(/-t500x500\.jpg$/, "-original.jpg");
const trackThumbnail = (src: string) => src.replace(/-t500x500\.jpg$/, "-t200x200.jpg");

const toIsoDuration = (duration: string) => {
	const [minutes, seconds] = duration.split(":").map(Number);
	return `PT${minutes}M${seconds}S`;
};

const structuredData = {
	"@context": "https://schema.org",
	"@graph": albums.map((album) => ({
		"@type": "MusicAlbum",
		name: album.title,
		byArtist: { "@id": `${SITE_URL}/#musicgroup` },
		datePublished: new Date(album.releaseDate).toISOString().slice(0, 10),
		image: new URL(album.artwork, SITE_URL).href,
		url: album.spotifyUrl || album.albumUrl,
		numTracks: album.tracks.length,
		track: album.tracks.map((track) => ({
			"@type": "MusicRecording",
			name: track.title,
			duration: toIsoDuration(track.duration),
			url: track.url,
			byArtist: { "@id": `${SITE_URL}/#musicgroup` },
		})),
	})),
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
	socialImageUrl={socialImageUrl}
	structuredData={structuredData}
	active="music"
>

<style>

			.albums-section {
				max-width: var(--content-width);
				margin: 0 auto;
				padding: 3rem var(--gutter);
				display: flex;
				flex-direction: column;
				gap: 4rem;
			}

			.album-card {
				border: 1px solid var(--line);
				border-radius: 2px;
				background: rgba(24, 20, 15, 0.25);
				overflow: clip;
			}

			.album-meta {
				display: grid;
				grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
				gap: clamp(1.5rem, 4vw, 3rem);
				padding: clamp(1.25rem, 3vw, 2.5rem);
				border-bottom: 1px solid var(--line);
			}

			.album-artwork {
				display: block;
				aspect-ratio: 1 / 1;
				width: 100%;
				height: auto;
				object-fit: contain;
				border-radius: 2px;
				border: 1px solid var(--line);
				box-shadow: 0 8px 22px rgba(0, 0, 0, 0.35);
			}

			.album-copy h2 {
				font-size: clamp(1.5rem, 2.6vw, 2rem);
				margin-bottom: 0.45rem;
			}

			.album-detail-line {
				display: flex;
				flex-wrap: wrap;
				gap: 0.65rem;
				font-family: "Cinzel", serif;
				font-size: 0.74rem;
				letter-spacing: 0.025em;

				color: var(--ink-soft);
				margin-bottom: 0.8rem;
			}

			.album-description {
				font-size: 0.98rem;
				line-height: 1.75;
				color: rgba(232, 224, 212, 0.78);
				margin-bottom: 1rem;
			}

			.album-link {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-family: "Cinzel", serif;
				font-size: 0.75rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--gold);
				border: 1px solid rgba(184, 154, 106, 0.38);
				border-radius: 2px;
				padding: 0.7rem 1rem;
				transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
			}

			.album-link:hover {
				color: var(--gold-bright);
				border-color: var(--gold);
				background: rgba(184, 154, 106, 0.08);
			}

			@media (prefers-reduced-motion: reduce) {
				.album-link { transition: none; }
			}

			.album-link svg {
				width: 1.1rem;
				height: 1.1rem;
				flex-shrink: 0;
			}

			.track-list-wrap {
				padding: 0 clamp(1.25rem, 3vw, 2.5rem) 1rem;
			}

			.track-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.track-row {
				display: grid;
				grid-template-columns: 1.5rem 72px minmax(0, 1fr) auto auto;
				align-items: center;
				gap: 1rem;
				padding: 1rem 0;
			}

			.track-row + .track-row { border-top: 1px solid var(--line); }
			.track-number, .track-duration { color: var(--ink-soft); font-variant-numeric: tabular-nums; }
			.track-number { font-size: 0.875rem; }
			.track-title { font-size: 1rem; font-weight: 500; overflow-wrap: anywhere; }
			.track-artwork { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; }
			.track-play {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.5rem;
				min-width: 44px;
				min-height: 44px;
				padding: 0.5rem 0.75rem;
				border: 1px solid var(--gold);
				border-radius: 2px;
				color: var(--gold-bright);
				font-size: 0.875rem;
			}
			.track-play svg { width: 1rem; height: 1rem; flex-shrink: 0; }
			.track-play:focus-visible, .artwork-lightbox-close:focus-visible { outline: 2px solid var(--gold-bright); outline-offset: 3px; }
			.track-play:active { background: rgba(184, 154, 106, 0.2); }
			@media (hover: hover) {
				.track-play:hover { background: rgba(184, 154, 106, 0.12); }
				.artwork-trigger:hover { outline: 1px solid var(--gold); outline-offset: 2px; }
			}
			@media (max-width: 600px) {
				.track-row { grid-template-columns: 56px minmax(0, 1fr) 44px; gap: 0.5rem 0.75rem; }
				.track-number { display: none; }
				.track-row .artwork-trigger { grid-column: 1; grid-row: 1 / 3; }
				.track-title { grid-column: 2; align-self: end; }
				.track-duration { grid-column: 2; grid-row: 2; align-self: start; font-size: 0.875rem; }
				.track-play { grid-column: 3; grid-row: 1 / 3; padding: 0.5rem; }
				.track-play-label { display: none; }
			}
			.track-play { background: transparent; font-family: inherit; cursor: pointer; }
			.track-play[aria-pressed="true"] { background: rgba(184, 154, 106, 0.2); }
			.track-play .pause-icon { display: none; }
			.track-play[aria-pressed="true"] .play-icon { display: none; }
			.track-play[aria-pressed="true"] .pause-icon { display: block; }

			.artwork-trigger {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0;
				border: 0;
				background: transparent;
				cursor: zoom-in;
				border-radius: 0.25rem;
			}

			.artwork-trigger:focus-visible {
				outline: 2px solid var(--gold);
				outline-offset: 2px;
			}

			.artwork-trigger-album {
				align-self: start;
			}


			.artwork-lightbox {
				position: fixed;
				inset: 0;
				margin: auto;
				padding: 0;
				border: 0;
				max-width: calc(100vw - 2.4rem);
				max-height: calc(100dvh - 2.4rem);
				background: #0d0a07;
				color: var(--ink);
			}

			.artwork-lightbox::backdrop {
				background: rgba(4, 3, 2, 0.88);
				backdrop-filter: blur(3px);
			}

			.artwork-lightbox-dialog {
				position: relative;
				max-width: min(92vw, 980px);
				max-height: calc(100dvh - 2.4rem);
				border: 1px solid rgba(184, 154, 106, 0.5);
				border-radius: 0.55rem;
				background: #0d0a07;
				box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6);
				overflow: hidden;
			}

			.artwork-lightbox-image {
				display: block;
				max-width: min(92vw, 980px);
				max-height: calc(100dvh - 160px);
				width: auto;
				height: auto;
			}

			.artwork-lightbox-caption {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				align-items: baseline;
				padding: 0.75rem 0.9rem;
				border-top: 1px solid rgba(184, 154, 106, 0.22);
			}

			.artwork-lightbox-title {
				font-family: "Cinzel", serif;
				font-size: 0.9rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--ink);
				overflow-wrap: anywhere;
			}

			.artwork-lightbox-meta {
				font-size: 0.82rem;
				color: var(--ink-soft);
			}

			.artwork-lightbox-close {
				position: absolute;
				top: 0.45rem;
				right: 0.45rem;
				width: 44px;
				height: 44px;
				border: 1px solid rgba(184, 154, 106, 0.5);
				border-radius: 999px;
				background: rgba(8, 6, 4, 0.8);
				color: var(--gold-bright);
				font-size: 1.1rem;
				line-height: 1;
				cursor: pointer;
				display: grid;
				place-items: center;
			}
			.artwork-lightbox-close svg { width: 20px; height: 20px; }

			.artwork-lightbox-status { padding: 1rem; color: var(--ink-soft); }


			.stream-links {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				align-items: center;
				gap: 0.85rem;
				padding: 0.5rem 0;
			}

			.stream-links-label {
				text-align: center;
				color: var(--ink-soft);
				font-size: 0.82rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				font-family: "Cinzel", serif;
				margin-bottom: 0.75rem;
			}

			@media (max-width: 860px) {
				.album-meta {
					grid-template-columns: 1fr;
				}

				.album-artwork {
					max-width: 360px;
				}

				.artwork-lightbox-caption {
					flex-direction: column;
					gap: 0.25rem;
				}
			}
</style>

		<main id="main">
			<PageHeader title="Music" description="Albums, singles, and the worlds within them." />

			<div class="albums-section">
				{
					albums.map((album) => {
						return (
						<article class="album-card" id={album.title.toLowerCase().replaceAll(" ", "-")}>
							<div class="album-meta">
								<button
									type="button"
									class="artwork-trigger artwork-trigger-album"
									data-artwork-src={fullArtwork(album.artwork)}
									data-artwork-fallback={album.artwork}
									data-artwork-title={`${album.title} Cover`}
									data-artwork-meta={`${album.type} • Released ${album.releaseDate}`}
									aria-label={`Open full artwork for ${album.title}`}
								>
									<img class="album-artwork" src={album.artwork} width="500" height="500" alt={`${album.title} cover art`} loading="lazy" />
								</button>
								<div class="album-copy">
									<h2>{album.title}</h2>
									<div class="album-detail-line">
										<span>{album.type}</span>
										<span>{album.year}</span>
										<span>{album.tracks.length} Tracks</span>
										<span>Released {album.releaseDate}</span>
									</div>
									<p class="album-description">{album.description}</p>
								<div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;">
									<a class="album-link" href={album.albumUrl} target="_blank" rel="noopener noreferrer"><Icon name="simple-icons:soundcloud" aria-hidden="true" />SoundCloud</a>
									{album.spotifyUrl && <a class="album-link" href={album.spotifyUrl} target="_blank" rel="noopener noreferrer"><Icon name="simple-icons:spotify" aria-hidden="true" />Spotify</a>}
									{album.appleMusicUrl && <a class="album-link" href={album.appleMusicUrl} target="_blank" rel="noopener noreferrer"><Icon name="simple-icons:applemusic" aria-hidden="true" />Apple Music</a>}
								</div>
								</div>
							</div>

							<div class="track-list-wrap">
								<ol class="track-list" aria-label={`${album.title} tracks`}>
									{album.tracks.map((track, index) => (
										<li class="track-row">
											<span class="track-number" aria-hidden="true">{index + 1}</span>
											<button type="button" class="artwork-trigger"
												data-artwork-src={fullArtwork(track.artwork)}
												data-artwork-fallback={track.artwork}
												data-artwork-title={track.title}
												data-artwork-meta={album.title}
												aria-label={`Open full artwork for ${track.title}`}>
												<img class="track-artwork" src={trackThumbnail(track.artwork)} width="72" height="72" alt={`${track.title} artwork`} loading="lazy" decoding="async" />
											</button>
											<a class="track-title" href={track.url} target="_blank" rel="noopener noreferrer">{track.title}</a>
											<span class="track-duration">{track.duration}</span>
											<button class="track-play" type="button" data-track-url={track.url}
												data-track-title={track.title} data-track-artwork={trackThumbnail(track.artwork)}
												data-track-album={album.title} aria-label={`Play ${track.title}`} aria-pressed="false">
												<Icon class="play-icon" name="lucide:play" aria-hidden="true" />
												<Icon class="pause-icon" name="lucide:pause" aria-hidden="true" />
												<span class="track-play-label">Play</span>
											</button>
										</li>
									))}
								</ol>
							</div>
						</article>
						);
					})
				}

				<div>
					<p class="stream-links-label">Stream on</p>
					<div class="stream-links">
						<a class="album-link" href="https://soundcloud.com/pneumaris" target="_blank" rel="noopener noreferrer">
							<Icon name="simple-icons:soundcloud" aria-hidden="true" />SoundCloud
						</a>
						<a class="album-link" href="https://open.spotify.com/artist/0LwtEDzdDXRarZ1H4eLqnU" target="_blank" rel="noopener noreferrer">
							<Icon name="simple-icons:spotify" aria-hidden="true" />Spotify
						</a>
						<a class="album-link" href="https://music.apple.com/us/artist/pneumaris/1896511324" target="_blank" rel="noopener noreferrer">
							<Icon name="simple-icons:applemusic" aria-hidden="true" />Apple Music
						</a>
					</div>
				</div>
			</div>

			<dialog id="artwork-lightbox" class="artwork-lightbox" aria-labelledby="artwork-lightbox-title">
				<div class="artwork-lightbox-dialog">
					<button type="button" class="artwork-lightbox-close" data-artwork-close aria-label="Close artwork preview">
						<Icon name="lucide:x" aria-hidden="true" />
					</button>
					<img id="artwork-lightbox-image" class="artwork-lightbox-image" alt="Expanded artwork" />
					<p id="artwork-lightbox-status" class="artwork-lightbox-status" role="status" hidden></p>
					<div class="artwork-lightbox-caption">
						<strong id="artwork-lightbox-title" class="artwork-lightbox-title"></strong>
						<span id="artwork-lightbox-meta" class="artwork-lightbox-meta"></span>
					</div>
				</div>
			</dialog>
		</main>
		<TrackPlayer />


		<script>
			const lightbox = document.getElementById("artwork-lightbox") as HTMLDialogElement | null;
			const lightboxImage = document.getElementById("artwork-lightbox-image") as HTMLImageElement | null;
			const lightboxTitle = document.getElementById("artwork-lightbox-title") as HTMLElement | null;
			const lightboxMeta = document.getElementById("artwork-lightbox-meta") as HTMLElement | null;
			const lightboxStatus = document.getElementById("artwork-lightbox-status");
			let previousOverflow = "";
			let artworkFallback = "";

			const openArtworkLightbox = (src: string, fallback: string, title: string, meta: string) => {
				if (!lightbox || !lightboxImage || !lightboxTitle || !lightboxMeta) return;
				artworkFallback = fallback;
				lightboxImage.hidden = false;
				if (lightboxStatus) {
					lightboxStatus.textContent = "Loading artwork…";
					lightboxStatus.hidden = false;
				}
				lightboxImage.alt = `${title} artwork`;
				lightboxImage.src = src;
				lightboxTitle.textContent = title;
				lightboxMeta.textContent = meta;
				previousOverflow = document.body.style.overflow;
				lightbox.showModal();
				document.body.style.overflow = "hidden";
			};

			const closeArtworkLightbox = () => {
				lightbox?.close();
			};

			lightbox?.addEventListener("close", () => {
				lightboxImage?.removeAttribute("src");
				document.body.style.overflow = previousOverflow;
			});
			lightboxImage?.addEventListener("load", () => {
				if (lightboxStatus) lightboxStatus.hidden = true;
			});
			lightboxImage?.addEventListener("error", () => {
				if (!lightbox?.open || !lightboxImage) return;
				if (artworkFallback && lightboxImage.src !== artworkFallback) {
					lightboxImage.src = artworkFallback;
					artworkFallback = "";
					return;
				}
				lightboxImage.hidden = true;
				if (lightboxStatus) {
					lightboxStatus.textContent = "Artwork could not load. Close the preview and try again.";
					lightboxStatus.hidden = false;
				}
			});

			document.addEventListener("click", (event) => {
				if (!(event.target instanceof Element)) return;

				const trigger = event.target.closest("[data-artwork-src]");
				if (trigger instanceof HTMLElement) {
					const src = trigger.dataset.artworkSrc;
					if (!src) return;
					openArtworkLightbox(
						src,
						trigger.dataset.artworkFallback || "",
						trigger.dataset.artworkTitle || "Artwork",
						trigger.dataset.artworkMeta || "",
					);
					return;
				}

				if (event.target.closest("[data-artwork-close]")) {
					closeArtworkLightbox();
					return;
				}

				if (lightbox && event.target === lightbox) {
					closeArtworkLightbox();
				}
			});

		</script>
</Layout>
