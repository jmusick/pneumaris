const pageTitle = "Music — Pneumaris";
const pageDescription = "Listen to Pneumaris albums with artwork and embedded playback.";
const canonicalUrl = `${SITE_URL}/music/`;
const socialImageUrl = `${SITE_URL}/header.png`;
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
	socialImageUrl={socialImageUrl}
	active="music"
>

<style>
			.page-header {
				border-bottom: 1px solid var(--line);
				padding: 3.5rem clamp(1.1rem, 3vw, 2.4rem) 2.5rem;
				background: linear-gradient(to bottom, rgba(60, 40, 12, 0.08), transparent);
			}

			.page-header-inner {
				max-width: 1280px;
				margin: 0 auto;
			}

			.page-header .section-label {
				margin-bottom: 0.6rem;
				display: block;
			}

			.page-header h1 {
				font-size: clamp(2rem, 5vw, 3.5rem);
			}

			.albums-section {
				max-width: 1280px;
				margin: 0 auto;
				padding: 3rem clamp(1.1rem, 3vw, 2.4rem);
				display: flex;
				flex-direction: column;
				gap: 2.2rem;
			}

			.album-card {
				border: 1px solid var(--line);
				border-radius: 0.55rem;
				background: linear-gradient(to bottom, rgba(28, 20, 13, 0.35), rgba(10, 8, 6, 0.4));
				overflow: clip;
			}

			.album-meta {
				display: grid;
				grid-template-columns: minmax(180px, 240px) 1fr;
				gap: 1.5rem;
				padding: 1.3rem;
				border-bottom: 1px solid var(--line);
			}

			.album-artwork {
				aspect-ratio: 1 / 1;
				width: 100%;
				object-fit: cover;
				border-radius: 0.45rem;
				border: 1px solid var(--line);
				box-shadow: 0 8px 22px rgba(0, 0, 0, 0.35);
			}

			.album-copy h2 {
				font-size: clamp(1.5rem, 2.6vw, 2rem);
				margin-bottom: 0.45rem;
			}

			.album-detail-line {
				display: flex;
				flex-wrap: wrap;
				gap: 0.65rem;
				font-family: "Cinzel", serif;
				font-size: 0.74rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--ink-soft);
				margin-bottom: 0.8rem;
			}

			.album-description {
				font-size: 0.98rem;
				line-height: 1.75;
				color: rgba(232, 224, 212, 0.78);
				margin-bottom: 1rem;
			}

			.album-link {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-family: "Cinzel", serif;
				font-size: 0.75rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--gold);
				border: 1px solid rgba(184, 154, 106, 0.38);
				border-radius: 2rem;
				padding: 0.45rem 0.9rem;
				transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
			}

			.album-link:hover {
				color: var(--gold-bright);
				border-color: var(--gold);
				background: rgba(184, 154, 106, 0.08);
			}

			.album-link svg {
				width: 1.1rem;
				height: 1.1rem;
				flex-shrink: 0;
			}

			.track-list-wrap {
				padding: 1.15rem 1.3rem 1.3rem;
			}


			.artwork-trigger {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0;
				border: 0;
				background: transparent;
				cursor: zoom-in;
				border-radius: 0.25rem;
			}

			.artwork-trigger:focus-visible {
				outline: 2px solid var(--gold);
				outline-offset: 2px;
			}

			.artwork-trigger-album {
				align-self: start;
			}


			.artwork-lightbox {
				position: fixed;
				inset: 0;
				z-index: 1000;
				display: grid;
				place-items: center;
				padding: 1.2rem;
				background: rgba(4, 3, 2, 0.88);
				backdrop-filter: blur(3px);
			}

			.artwork-lightbox[hidden] {
				display: none;
			}

			.artwork-lightbox-dialog {
				position: relative;
				max-width: min(92vw, 980px);
				max-height: 92vh;
				border: 1px solid rgba(184, 154, 106, 0.5);
				border-radius: 0.55rem;
				background: #0d0a07;
				box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6);
				overflow: hidden;
			}

			.artwork-lightbox-image {
				display: block;
				max-width: min(92vw, 980px);
				max-height: calc(92vh - 96px);
				width: auto;
				height: auto;
			}

			.artwork-lightbox-caption {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				align-items: baseline;
				padding: 0.75rem 0.9rem;
				border-top: 1px solid rgba(184, 154, 106, 0.22);
			}

			.artwork-lightbox-title {
				font-family: "Cinzel", serif;
				font-size: 0.9rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--ink);
			}

			.artwork-lightbox-meta {
				font-size: 0.82rem;
				color: var(--ink-soft);
			}

			.artwork-lightbox-close {
				position: absolute;
				top: 0.45rem;
				right: 0.45rem;
				width: 2rem;
				height: 2rem;
				border: 1px solid rgba(184, 154, 106, 0.5);
				border-radius: 999px;
				background: rgba(8, 6, 4, 0.8);
				color: var(--gold-bright);
				font-size: 1.1rem;
				line-height: 1;
				cursor: pointer;
			}

			.album-player {
				border: 1px solid rgba(184, 154, 106, 0.2);
				border-radius: 0.35rem;
				overflow: hidden;
			}

			.album-player iframe {
				display: block;
				width: 100%;
				height: 166px;
			}


			.stream-links {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				align-items: center;
				gap: 0.85rem;
				padding: 0.5rem 0;
			}

			.stream-links-label {
				text-align: center;
				color: var(--ink-soft);
				font-size: 0.82rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				font-family: "Cinzel", serif;
				margin-bottom: 0.75rem;
			}

			@media (max-width: 860px) {
				.album-meta {
					grid-template-columns: 1fr;
				}

				.album-artwork {
					max-width: 360px;
				}

				.artwork-lightbox-caption {
					flex-direction: column;
					gap: 0.25rem;
				}
			}
</style>

		<main>
			<div class="page-header">
				<div class="page-header-inner">
					<span class="section-label">Discography & Streams</span>
					<h1>Music</h1>
				</div>
			</div>

			<div class="albums-section">
				{
					albums.map((album) => {
						const spotifyAlbumId = album.spotifyUrl?.match(/open\.spotify\.com\/album\/([A-Za-z0-9]+)/)?.[1];
						const isSpotifyEmbed = Boolean(spotifyAlbumId);
						const spotifyEmbedHeight = Math.min(760, Math.max(352, 170 + album.tracks.length * 34));
						const preferredEmbedUrl = isSpotifyEmbed
							? `https://open.spotify.com/embed/album/${spotifyAlbumId}?utm_source=generator&theme=0`
							: album.embedUrl;

						return (
						<article class="album-card">
							<div class="album-meta">
								<button
									type="button"
									class="artwork-trigger artwork-trigger-album"
									data-artwork-src={album.artwork}
									data-artwork-title={`${album.title} Cover`}
									data-artwork-meta={`${album.type} • Released ${album.releaseDate}`}
									aria-label={`Open full artwork for ${album.title}`}
								>
									<img class="album-artwork" src={album.artwork} alt={`${album.title} cover art`} loading="lazy" />
								</button>
								<div class="album-copy">
									<h2>{album.title}</h2>
									<div class="album-detail-line">
										<span>{album.type}</span>
										<span>{album.year}</span>
										<span>{album.tracks.length} Tracks</span>
										<span>Released {album.releaseDate}</span>
									</div>
									<p class="album-description">{album.description}</p>
								<div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;">
									<a class="album-link" href={album.albumUrl} target="_blank" rel="noopener noreferrer"><Icon name="simple-icons:soundcloud" aria-hidden="true" />SoundCloud</a>
									{album.spotifyUrl && <a class="album-link" href={album.spotifyUrl} target="_blank" rel="noopener noreferrer"><Icon name="simple-icons:spotify" aria-hidden="true" />Spotify</a>}
									{album.appleMusicUrl && <a class="album-link" href={album.appleMusicUrl} target="_blank" rel="noopener noreferrer"><Icon name="simple-icons:applemusic" aria-hidden="true" />Apple Music</a>}
								</div>
								</div>
							</div>

							<div class="track-list-wrap">
								<div class="album-player">
									<iframe
										class={isSpotifyEmbed ? "spotify-player" : undefined}
										frameborder="no"
										allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
										src={preferredEmbedUrl}
										title={`${album.title} ${isSpotifyEmbed ? "Spotify" : "SoundCloud"} player`}
										style={isSpotifyEmbed ? `height: ${spotifyEmbedHeight}px;` : undefined}
									></iframe>
								</div>
							</div>
						</article>
						);
					})
				}

				<div>
					<p class="stream-links-label">Stream on</p>
					<div class="stream-links">
						<a class="album-link" href="https://soundcloud.com/pneumaris" target="_blank" rel="noopener noreferrer">
							<Icon name="simple-icons:soundcloud" aria-hidden="true" />SoundCloud
						</a>
						<a class="album-link" href="https://open.spotify.com/artist/0LwtEDzdDXRarZ1H4eLqnU" target="_blank" rel="noopener noreferrer">
							<Icon name="simple-icons:spotify" aria-hidden="true" />Spotify
						</a>
						<a class="album-link" href="https://music.apple.com/us/artist/pneumaris/1896511324" target="_blank" rel="noopener noreferrer">
							<Icon name="simple-icons:applemusic" aria-hidden="true" />Apple Music
						</a>
					</div>
				</div>
			</div>

			<div id="artwork-lightbox" class="artwork-lightbox" hidden>
				<div class="artwork-lightbox-dialog" role="dialog" aria-modal="true" aria-labelledby="artwork-lightbox-title">
					<button type="button" class="artwork-lightbox-close" data-artwork-close aria-label="Close artwork preview">
						×
					</button>
					<img id="artwork-lightbox-image" class="artwork-lightbox-image" src="" alt="Expanded artwork" />
					<div class="artwork-lightbox-caption">
						<strong id="artwork-lightbox-title" class="artwork-lightbox-title"></strong>
						<span id="artwork-lightbox-meta" class="artwork-lightbox-meta"></span>
					</div>
				</div>
			</div>
		</main>


		<script>
			const lightbox = document.getElementById("artwork-lightbox") as HTMLElement | null;
			const lightboxImage = document.getElementById("artwork-lightbox-image") as HTMLImageElement | null;
			const lightboxTitle = document.getElementById("artwork-lightbox-title") as HTMLElement | null;
			const lightboxMeta = document.getElementById("artwork-lightbox-meta") as HTMLElement | null;

			const openArtworkLightbox = (src: string, title: string, meta: string) => {
				if (!lightbox || !lightboxImage || !lightboxTitle || !lightboxMeta) return;
				lightboxImage.src = src;
				lightboxTitle.textContent = title;
				lightboxMeta.textContent = meta;
				lightbox.hidden = false;
				document.body.style.overflow = "hidden";
			};

			const closeArtworkLightbox = () => {
				if (!lightbox || !lightboxImage) return;
				lightbox.hidden = true;
				lightboxImage.src = "";
				document.body.style.overflow = "";
			};

			document.addEventListener("click", (event) => {
				if (!(event.target instanceof Element)) return;

				const trigger = event.target.closest("[data-artwork-src]");
				if (trigger instanceof HTMLElement) {
					const src = trigger.dataset.artworkSrc;
					if (!src) return;
					openArtworkLightbox(
						src,
						trigger.dataset.artworkTitle || "Artwork",
						trigger.dataset.artworkMeta || "",
					);
					return;
				}

				if (event.target.closest("[data-artwork-close]")) {
					closeArtworkLightbox();
					return;
				}

				if (lightbox && event.target === lightbox) {
					closeArtworkLightbox();
				}
			});

			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && lightbox && !lightbox.hidden) {
					closeArtworkLightbox();
				}
			});
		</script>
</Layout>
