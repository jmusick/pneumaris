---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import TrackPlayer from "../components/TrackPlayer.astro";
import ListenLinks from "../components/ListenLinks.astro";
import { Icon } from "astro-icon/components";
import { SITE_URL, socialProfile } from "../config/site";

import { albums, releaseSlug } from "../data/releases";

// Artist profiles in the same order as the store links: Spotify and Apple Music lead.
const followProfiles = (["spotify", "applemusic", "soundcloud"] as const).map(socialProfile);

const pageTitle = "Music | Pneumaris";
const pageDescription = "Listen to Reverie, the new 18-track Pneumaris album, on Spotify, Apple Music, and SoundCloud. Explore the full discography and artwork for every track.";
const canonicalUrl = `${SITE_URL}/music/`;
const socialImageUrl = `${SITE_URL}/images/reverie-social.jpg`;

// Older releases with long track lists open on their first few tracks; the newest stays whole.
const PREVIEW_TRACKS = 3;
const collapses = (index: number, trackCount: number) => index > 0 && trackCount > PREVIEW_TRACKS + 2;

const fullArtwork =(src: string) => src.replace(/-t500x500\.jpg$/, "-original.jpg");
const trackThumbnail = (src: string) => src.replace(/-t500x500\.jpg$/, "-t200x200.jpg");

const toIsoDuration = (duration: string) => {
	const [minutes, seconds] = duration.split(":").map(Number);
	return `PT${minutes}M${seconds}S`;
};

const structuredData = {
	"@context": "https://schema.org",
	"@graph": albums.map((album) => ({
		"@type": "MusicAlbum",
		name: album.title,
		byArtist: { "@id": `${SITE_URL}/#musicgroup` },
		datePublished: new Date(album.releaseDate).toISOString().slice(0, 10),
		image: new URL(album.artwork, SITE_URL).href,
		url: album.spotifyUrl || album.albumUrl,
		numTracks: album.tracks.length,
		track: album.tracks.map((track) => ({
			"@type": "MusicRecording",
			name: track.title,
			duration: toIsoDuration(track.duration),
			url: track.url,
			byArtist: { "@id": `${SITE_URL}/#musicgroup` },
		})),
	})),
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
	socialImageUrl={socialImageUrl}
	socialImageAlt="Reverie album artwork by Pneumaris"
	structuredData={structuredData}
	active="music"
>

<style>
 .album-schedule { margin: 0; color: var(--ink-soft); font-size: 1rem; }
 .album-schedule time { font-variant-numeric: tabular-nums; }
 .album-card:first-child .album-copy h2 { font-size: clamp(2.5rem, 5vw, 4rem); }
 /* Reading order: name, facts, then the way to listen; the story follows. */
 .album-actions { margin: 1.5rem 0 2rem; }


			.albums-section {
				max-width: var(--content-width);
				margin: 0 auto;
				padding: 3rem var(--gutter);
				display: flex;
				flex-direction: column;
				gap: 4rem;
			}

			.album-card {
				border: 0;
				border-radius: 2px;
				background: transparent;
				overflow: clip;
			}

			.album-meta {
				display: grid;
				grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
				gap: clamp(1.5rem, 4vw, 3rem);
				padding: clamp(1.25rem, 3vw, 2.5rem);
				border-bottom: 1px solid var(--line);
			}

			.album-artwork {
				display: block;
				aspect-ratio: 1 / 1;
				width: 100%;
				height: auto;
				object-fit: contain;
				border-radius: 2px;
				border: 1px solid var(--line);
				box-shadow: 0 8px 22px rgba(0, 0, 0, 0.35);
			}

			.album-copy h2 {
				font-size: clamp(1.5rem, 2.6vw, 2rem);
				margin-bottom: 0.45rem;
			}

			.album-detail-line {
				display: flex;
				flex-wrap: wrap;
				gap: 0.65rem;
				font-family: "Cinzel", serif;
				font-size: 1rem;
				letter-spacing: 0.025em;

				color: var(--ink-soft);
				margin-bottom: 0.8rem;
			}

			.album-description {
				font-size: 1rem;
				line-height: 1.6;
				color: var(--ink);
				max-width: 70ch;
				white-space: pre-line;
			}

			.track-list-wrap {
				padding: 0 clamp(1.25rem, 3vw, 2.5rem) 1rem;
			}

			.track-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.track-row {
				display: grid;
				grid-template-columns: 1.5rem 72px minmax(0, 1fr) auto auto;
				align-items: center;
				gap: 1rem;
				padding: 1rem 0;
			}

			.track-row + .track-row { border-top: 1px solid var(--line); }
			.track-list[data-collapsed] .track-row-more { display: none; }

			.track-more {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				min-height: 44px;
				margin-top: 0.5rem;
				padding: 0;
				background: transparent;
				border: 0;
				border-bottom: 1px solid var(--gold-dim);
				border-radius: 0;
				color: var(--ink);
				font: inherit;
				cursor: pointer;
				transition: border-color 160ms ease;
			}
			.track-more[hidden] { display: none; }
			.track-more:hover { border-bottom-color: var(--gold-bright); }
			.track-more svg { width: 1rem; height: 1rem; color: var(--gold); transition: transform 200ms ease; }
			.track-more[aria-expanded="true"] svg { transform: rotate(180deg); }
			@media (prefers-reduced-motion: reduce) {
				.track-more, .track-more svg { transition: none; }
			}

			.release-index {
				max-width: var(--content-width);
				margin: 0 auto;
				padding: 1.5rem calc(var(--gutter) + clamp(1.25rem, 3vw, 2.5rem)) 0;
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0 1.5rem;
			}
			.release-index ol {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0 1.5rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.release-index-label {
				color: var(--ink-soft);
				font-size: 0.75rem;
				letter-spacing: 0.14em;
				text-transform: uppercase;
			}
			.release-index a {
				display: inline-flex;
				align-items: center;
				min-height: 44px;
				color: var(--ink);
				text-decoration: underline;
				text-decoration-color: var(--gold-dim);
				text-underline-offset: 0.3em;
				transition: text-decoration-color 160ms ease, color 160ms ease;
			}
			.release-index a:hover { color: var(--gold-bright); text-decoration-color: var(--gold-bright); }
			/* On phones the index is one swipeable line, so it never pushes the newest release down. */
			@media (max-width: 600px) {
				.release-index, .release-index ol { flex-wrap: nowrap; }
				.release-index {
					gap: 0 1.25rem;
					padding: 1rem var(--gutter) 0.25rem;
					overflow-x: auto;
					overscroll-behavior-x: contain;
					scrollbar-width: none;
				}
				.release-index::-webkit-scrollbar { display: none; }
				.release-index ol { gap: 0 1.25rem; padding: 0.25rem var(--gutter) 0.25rem 0; }
				.release-index li, .release-index-label { flex-shrink: 0; white-space: nowrap; }
				.release-index a:focus-visible { outline-offset: 3px; }
				.albums-section { padding-top: 2rem; }
			}
			@media (prefers-reduced-motion: reduce) {
				.release-index a { transition: none; }
			}
			.track-number, .track-duration { color: var(--ink-soft); font-variant-numeric: tabular-nums; }
			.track-number { font-size: 0.875rem; }
			.track-title { font-size: 1rem; font-weight: 500; overflow-wrap: anywhere; }
			.track-artwork { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; }
			.track-play {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.5rem;
				min-width: 44px;
				min-height: 44px;
				padding: 0.5rem 0.75rem;
				border: 1px solid var(--gold);
				border-radius: 2px;
				color: var(--gold-bright);
				font-size: 0.875rem;
			}
			.track-play svg { width: 1rem; height: 1rem; flex-shrink: 0; }
			.track-play:focus-visible, .artwork-lightbox-close:focus-visible { outline: 2px solid var(--gold-bright); outline-offset: 3px; }
			.track-play:active { background: var(--gold-press); }
			@media (hover: hover) {
				.track-play:hover { background: var(--gold-hover); }
				.artwork-trigger:hover { outline: 1px solid var(--gold); outline-offset: 2px; }
			}
			@media (max-width: 600px) {
				.track-row { grid-template-columns: 56px minmax(0, 1fr) 44px; gap: 0.5rem 0.75rem; }
				.track-number { display: none; }
				.track-row .artwork-trigger { grid-column: 1; grid-row: 1 / 3; }
				.track-title { grid-column: 2; align-self: end; }
				.track-duration { grid-column: 2; grid-row: 2; align-self: start; font-size: 0.875rem; }
				.track-play { grid-column: 3; grid-row: 1 / 3; padding: 0.5rem; }
				.track-play-label { display: none; }
			}
			.track-play { background: transparent; font-family: inherit; cursor: pointer; }
			.track-play[aria-pressed="true"] { background: var(--gold-press); }
			.track-play .pause-icon { display: none; }
			.track-play[aria-pressed="true"] .play-icon { display: none; }
			.track-play[aria-pressed="true"] .pause-icon { display: block; }

			.artwork-trigger {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0;
				border: 0;
				background: transparent;
				cursor: zoom-in;
				border-radius: 0.25rem;
			}

			.artwork-trigger:focus-visible {
				outline: 2px solid var(--gold);
				outline-offset: 2px;
			}

			.artwork-trigger-album {
				align-self: start;
			}


			.artwork-lightbox {
				position: fixed;
				inset: 0;
				margin: auto;
				padding: 0;
				border: 0;
				max-width: calc(100vw - 2.4rem);
				max-height: calc(100dvh - 2.4rem);
				background: var(--surface-strong);
				color: var(--ink);
			}

			.artwork-lightbox::backdrop {
				background: color-mix(in srgb, var(--bg-base) 88%, transparent);

			}

			.artwork-lightbox-dialog {
				position: relative;
				max-width: min(92vw, 980px);
				max-height: calc(100dvh - 2.4rem);
				border: 1px solid color-mix(in srgb, var(--gold) 50%, transparent);
				border-radius: 0.55rem;
				background: var(--surface-strong);
				box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6);
				overflow: hidden;
			}

			.artwork-lightbox-image {
				display: block;
				max-width: min(92vw, 980px);
				max-height: calc(100dvh - 160px);
				width: auto;
				height: auto;
			}

			.artwork-lightbox-caption {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				align-items: baseline;
				padding: 0.75rem 0.9rem;
				border-top: 1px solid color-mix(in srgb, var(--gold) 22%, transparent);
			}

			.artwork-lightbox-title {
				font-family: "Cinzel", serif;
				font-size: 0.9rem;
				letter-spacing: 0.08em;
				text-transform: none;
				color: var(--ink);
				overflow-wrap: anywhere;
			}

			.artwork-lightbox-meta {
				font-size: 0.82rem;
				color: var(--ink-soft);
			}

			.artwork-lightbox-close {
				position: absolute;
				top: 0.45rem;
				right: 0.45rem;
				width: 44px;
				height: 44px;
				border: 1px solid color-mix(in srgb, var(--gold) 50%, transparent);
				border-radius: 999px;
				background: color-mix(in srgb, var(--bg-base) 80%, transparent);
				color: var(--gold-bright);
				font-size: 1.1rem;
				line-height: 1;
				cursor: pointer;
				display: grid;
				place-items: center;
			}
			.artwork-lightbox-close svg { width: 20px; height: 20px; }

			.artwork-lightbox-status { padding: 1rem; color: var(--ink-soft); }


			.follow-section {
				padding: 0 clamp(1.25rem, 3vw, 2.5rem);
			}

			.follow-section h2 {
				font-size: clamp(1.15rem, 2vw, 1.5rem);
				line-height: 1.2;
				margin-bottom: 1rem;
			}

			@media (max-width: 860px) {
				.album-meta {
					grid-template-columns: 1fr;
				}

				.album-artwork {
					max-width: 360px;
				}

				.artwork-lightbox-caption {
					flex-direction: column;
					gap: 0.25rem;
				}
			}
</style>

		<main id="main">
			<PageHeader title="Music" description="Albums, singles, and the worlds within them." />

			<nav class="release-index" aria-labelledby="release-index-label">
				<p class="release-index-label" id="release-index-label">Releases</p>
				<ol>
					{albums.map((album) => (
						<li><a href={`#${releaseSlug(album.title)}`}>{album.title}</a></li>
					))}
				</ol>
			</nav>

			<div class="albums-section">
				{
					albums.map((album, index) => {
						return (
						<article class="album-card" id={releaseSlug(album.title)}>
							<div class="album-meta">
								<button
									type="button"
									class="artwork-trigger artwork-trigger-album"
									data-artwork-src={fullArtwork(album.artwork)}
									data-artwork-fallback={album.artwork}
									data-artwork-title={`${album.title} Cover`}
									data-artwork-meta={`${album.type} • Released ${album.releaseDate}`}
									aria-label={`Open full artwork for ${album.title}`}
								>
									<img class="album-artwork" src={album.artwork} width="500" height="500" alt={`${album.title} cover art`} loading="lazy" />
								</button>
								<div class="album-copy">
									<h2>{album.title}</h2>
									<div class="album-detail-line">
										<span>{album.type}</span>
										<span>{album.year}</span>
										<span>{album.tracks.length} Tracks</span>
										<span>Released {album.releaseDate}</span>
									</div>
									{album.streamingReleaseDate && <p class="album-schedule">Out now on Spotify &amp; Apple Music. Released <time datetime={new Date(album.streamingReleaseDate).toISOString().slice(0, 10)}>{album.streamingReleaseDate}</time>.</p>}
									{/* The newest release keeps the page's one filled action; older ones stay quiet. */}
									<div class="album-actions"><ListenLinks album={album} quiet={index > 0} /></div>
									<p class="album-description">{album.description}</p>
								</div>
							</div>

							<div class="track-list-wrap">
								<ol class="track-list" id={`${releaseSlug(album.title)}-tracks`} aria-label={`${album.title} tracks`}>
									{album.tracks.map((track, trackIndex) => (
										<li class:list={["track-row", collapses(index, album.tracks.length) && trackIndex >= PREVIEW_TRACKS && "track-row-more"]}>
											<span class="track-number" aria-hidden="true">{trackIndex + 1}</span>
											<button type="button" class="artwork-trigger"
												data-artwork-src={fullArtwork(track.artwork)}
												data-artwork-fallback={track.artwork}
												data-artwork-title={track.title}
												data-artwork-meta={album.title}
												aria-label={`Open full artwork for ${track.title}`}>
												<img class="track-artwork" src={trackThumbnail(track.artwork)} width="72" height="72" alt={`${track.title} artwork`} loading="lazy" decoding="async" />
											</button>
											<a class="track-title" href={track.url} target="_blank" rel="noopener noreferrer">{track.title}</a>
											<span class="track-duration">{track.duration}</span>
											<button class="track-play" type="button" data-track-url={track.url}
												data-track-title={track.title} data-track-artwork={trackThumbnail(track.artwork)}
												data-track-album={album.title} aria-label={`Play ${track.title}`} aria-pressed="false">
												<Icon class="play-icon" name="lucide:play" aria-hidden="true" />
												<Icon class="pause-icon" name="lucide:pause" aria-hidden="true" />
												<span class="track-play-label">Play</span>
											</button>
										</li>
									))}
								</ol>
								{/* Without JavaScript every track stays listed and this toggle stays hidden. */}
								{collapses(index, album.tracks.length) && (
									<button type="button" class="track-more" data-track-toggle data-track-count={album.tracks.length}
										aria-controls={`${releaseSlug(album.title)}-tracks`} aria-expanded="false" hidden>
										<span class="track-more-label">Show all {album.tracks.length} tracks</span>
										<Icon name="lucide:chevron-down" aria-hidden="true" />
									</button>
								)}
							</div>
						</article>
						);
					})
				}

				<section class="follow-section" aria-labelledby="follow-title">
					<h2 id="follow-title">Follow Pneumaris</h2>
					<ListenLinks links={followProfiles} name="Follow Pneumaris" label="" quiet />
				</section>
			</div>

			<dialog id="artwork-lightbox" class="artwork-lightbox" aria-labelledby="artwork-lightbox-title">
				<div class="artwork-lightbox-dialog">
					<button type="button" class="artwork-lightbox-close" data-artwork-close aria-label="Close artwork preview">
						<Icon name="lucide:x" aria-hidden="true" />
					</button>
					<img id="artwork-lightbox-image" class="artwork-lightbox-image" width="1200" height="1200" alt="Expanded artwork" />
					<p id="artwork-lightbox-status" class="artwork-lightbox-status" role="status" hidden></p>
					<div class="artwork-lightbox-caption">
						<strong id="artwork-lightbox-title" class="artwork-lightbox-title"></strong>
						<span id="artwork-lightbox-meta" class="artwork-lightbox-meta"></span>
					</div>
				</div>
			</dialog>
		</main>
		<TrackPlayer />


		<script>
			const lightbox = document.getElementById("artwork-lightbox") as HTMLDialogElement | null;
			const lightboxImage = document.getElementById("artwork-lightbox-image") as HTMLImageElement | null;
			const lightboxTitle = document.getElementById("artwork-lightbox-title") as HTMLElement | null;
			const lightboxMeta = document.getElementById("artwork-lightbox-meta") as HTMLElement | null;
			const lightboxStatus = document.getElementById("artwork-lightbox-status");
			let previousOverflow = "";
			let artworkFallback = "";

			const openArtworkLightbox = (src: string, fallback: string, title: string, meta: string) => {
				if (!lightbox || !lightboxImage || !lightboxTitle || !lightboxMeta) return;
				artworkFallback = fallback;
				lightboxImage.hidden = false;
				if (lightboxStatus) {
					lightboxStatus.textContent = "Loading artwork…";
					lightboxStatus.hidden = false;
				}
				lightboxImage.alt = `${title} artwork`;
				lightboxImage.src = src;
				lightboxTitle.textContent = title;
				lightboxMeta.textContent = meta;
				previousOverflow = document.body.style.overflow;
				lightbox.showModal();
				document.body.style.overflow = "hidden";
			};

			const closeArtworkLightbox = () => {
				lightbox?.close();
			};

			lightbox?.addEventListener("close", () => {
				lightboxImage?.removeAttribute("src");
				document.body.style.overflow = previousOverflow;
			});
			lightboxImage?.addEventListener("load", () => {
				if (lightboxStatus) lightboxStatus.hidden = true;
			});
			lightboxImage?.addEventListener("error", () => {
				if (!lightbox?.open || !lightboxImage) return;
				if (artworkFallback && lightboxImage.src !== artworkFallback) {
					lightboxImage.src = artworkFallback;
					artworkFallback = "";
					return;
				}
				lightboxImage.hidden = true;
				if (lightboxStatus) {
					lightboxStatus.textContent = "Artwork could not load. Close the preview and try again.";
					lightboxStatus.hidden = false;
				}
			});

			// Older releases open on their first tracks. Collapse only once this script runs,
			// so the full lists stay readable without JavaScript.
			const trackToggles = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-track-toggle]"));
			const setExpanded = (toggle: HTMLButtonElement, expanded: boolean) => {
				const list = document.getElementById(toggle.getAttribute("aria-controls") || "");
				if (!list) return;
				list.toggleAttribute("data-collapsed", !expanded);
				toggle.setAttribute("aria-expanded", String(expanded));
				const label = toggle.querySelector(".track-more-label");
				if (label) label.textContent = expanded ? "Show fewer tracks" : `Show all ${toggle.dataset.trackCount} tracks`;
			};
			for (const toggle of trackToggles) {
				setExpanded(toggle, false);
				toggle.hidden = false;
				toggle.addEventListener("click", () => {
					const expand = toggle.getAttribute("aria-expanded") !== "true";
					setExpanded(toggle, expand);
					// Hiding rows pulls the toggle up the page; keep it in view.
					if (!expand) toggle.scrollIntoView({ block: "nearest" });
				});
				// The player advances through a release on its own: reveal a hidden track when it starts.
				const list = document.getElementById(toggle.getAttribute("aria-controls") || "");
				if (list) {
					new MutationObserver(() => {
						if (list.hasAttribute("data-collapsed") && list.querySelector(".track-row-more [aria-pressed='true']")) setExpanded(toggle, true);
					}).observe(list, { subtree: true, attributeFilter: ["aria-pressed"] });
				}
			}
			// Collapsing shortened the page above a linked release; land on it again.
			if (trackToggles.length && location.hash) document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView();

			document.addEventListener("click", (event) => {
				if (!(event.target instanceof Element)) return;

				const trigger = event.target.closest("[data-artwork-src]");
				if (trigger instanceof HTMLElement) {
					const src = trigger.dataset.artworkSrc;
					if (!src) return;
					openArtworkLightbox(
						src,
						trigger.dataset.artworkFallback || "",
						trigger.dataset.artworkTitle || "Artwork",
						trigger.dataset.artworkMeta || "",
					);
					return;
				}

				if (event.target.closest("[data-artwork-close]")) {
					closeArtworkLightbox();
					return;
				}

				if (lightbox && event.target === lightbox) {
					closeArtworkLightbox();
				}
			});

		</script>
</Layout>
