---
import Layout from "../layouts/Layout.astro";
import { SITE_URL } from "../config/site";

const pageTitle = "Privacy Policy — Pneumaris";
const pageDescription = "Privacy Policy for the Pneumaris website.";
const canonicalUrl = `${SITE_URL}/privacy-policy`;
const socialImageUrl = `${SITE_URL}/header.png`;
---

<Layout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl}>

<style>
			.page-header {
				border-bottom: 1px solid var(--line);
				padding: 3.5rem clamp(1.1rem, 3vw, 2.4rem) 2.5rem;
				background: linear-gradient(to bottom, rgba(60, 40, 12, 0.08), transparent);
			}

			.page-header-inner {
				max-width: 1280px;
				margin: 0 auto;
			}

			.page-header .section-label {
				margin-bottom: 0.6rem;
				display: block;
			}

			.page-header h1 {
				font-size: clamp(2rem, 5vw, 3.5rem);
			}

			.content {
				max-width: 720px;
				margin: 0 auto;
				padding: 3.5rem clamp(1.1rem, 3vw, 2.4rem);
				display: flex;
				flex-direction: column;
				gap: 2rem;
			}

			.content p,
			.content li {
				color: rgba(232, 224, 212, 0.72);
				font-size: 1.05rem;
				line-height: 1.8;
			}

			.content h2 {
				font-size: 1.05rem;
				margin-bottom: 0.5rem;
			}

			.content ul {
				margin: 0;
				padding-left: 1.4rem;
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
			}

			.policy-block {
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
			}

			.last-updated {
				font-size: 0.82rem;
				color: var(--ink-muted);
				letter-spacing: 0.05em;
			}
</style>

		<main>
			<div class="page-header">
				<div class="page-header-inner">
					<span class="section-label">Legal</span>
					<h1>Privacy Policy</h1>
				</div>
			</div>

			<div class="content">
				<p class="last-updated">Last updated: May 22, 2026</p>

				<div class="policy-block">
					<h2>Overview</h2>
					<p>
						This website (<strong>pneumarisband.com</strong>) is operated by Pneumaris.
						We are committed to protecting your privacy. This policy outlines what
						information, if any, is collected when you visit this site and how it
						is used.
					</p>
				</div>

				<div class="policy-block">
					<h2>Information We Collect</h2>
					<p>
						If you use the contact form, we collect the information you submit:
						name, email address, subject, and message content. This information is
						used only to review and respond to your inquiry.
					</p>
					<p>
						We also use a hidden anti-spam field and CAPTCHA verification to help
						prevent automated abuse of the form.
					</p>
				</div>

				<div class="policy-block">
					<h2>Analytics</h2>
					<p>
						This website uses <strong>Google Analytics 4</strong> (via Google's
						global site tag, gtag.js) to measure traffic and understand how
						visitors use the site. Google Analytics collects information such as
						pages visited, time on site, referral source, device type, and
						approximate geographic location.
					</p>
					<p>
						Google Analytics uses cookies (including <code>_ga</code> and
						<code>_ga_*</code>) to distinguish users and sessions. You can opt
						out using the
						<a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">Google Analytics Opt-out Browser Add-on</a>
						or by enabling Do Not Track in your browser. See the
						<a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google Privacy Policy</a>.
					</p>
				</div>

				<div class="policy-block">
					<h2>Third-Party Services</h2>
					<p>
						This site uses or links to third-party platforms that may collect
						data independently under their own privacy policies:
					</p>
					<ul>
						<li>
							<strong>Google Analytics</strong> — used to measure site traffic
							and visitor behavior. See the
							<a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google Privacy Policy</a>.
						</li>
						<li>
							<strong>Google Fonts</strong> — used to load typefaces. Google may
							log requests made to their font servers. See the
							<a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google Privacy Policy</a>.
						</li>
						<li>
							<strong>Web3Forms</strong> — used to process contact form
							submissions and deliver them to Pneumaris. See the
							<a href="https://web3forms.com/privacy" target="_blank" rel="noopener noreferrer">Web3Forms Privacy Policy</a>.
						</li>
						<li>
							<strong>hCaptcha</strong> — used to protect the contact form from
							spam and abuse. hCaptcha may process technical and behavioral data
							to perform bot detection. See the
							<a href="https://www.hcaptcha.com/privacy" target="_blank" rel="noopener noreferrer">hCaptcha Privacy Policy</a>.
						</li>
						<li>
							<strong>SoundCloud</strong> — used to stream music. SoundCloud may
							set cookies and collect usage data. See the
							<a href="https://soundcloud.com/pages/privacy" target="_blank" rel="noopener noreferrer">SoundCloud Privacy Policy</a>.
						</li>
						<li>
							<strong>Spotify</strong> — we link to our Spotify artist profile.
							Spotify may collect data if you visit their platform. See the
							<a href="https://www.spotify.com/legal/privacy-policy/" target="_blank" rel="noopener noreferrer">Spotify Privacy Policy</a>.
						</li>
						<li>
							<strong>Apple Music</strong> — we link to our Apple Music artist
							profile. Apple may collect data if you visit their platform. See
							the
							<a href="https://www.apple.com/legal/privacy/" target="_blank" rel="noopener noreferrer">Apple Privacy Policy</a>.
						</li>
					</ul>
				</div>

				<div class="policy-block">
					<h2>Cookies</h2>
					<p>
						This website uses cookies set by <strong>Google Analytics</strong>
						(<code>_ga</code>, <code>_ga_*</code>) to distinguish users and
						measure site usage. These cookies persist for up to 2 years. Third-party
						services such as SoundCloud and hCaptcha may also set their own cookies
						subject to their respective policies.
					</p>
					<p>
						You can disable or delete cookies through your browser settings, or
						opt out of Google Analytics tracking via the
						<a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">Google Analytics Opt-out Browser Add-on</a>.
					</p>
				</div>

				<div class="policy-block">
					<h2>External Links</h2>
					<p>
						This site may link to external websites. We are not responsible for
						the privacy practices or content of those sites.
					</p>
				</div>

				<div class="policy-block">
					<h2>Changes to This Policy</h2>
					<p>
						We may update this policy from time to time. Any changes will be
						reflected on this page with an updated date.
					</p>
				</div>

				<div class="policy-block">
					<h2>Contact</h2>
					<p>
						For any privacy-related questions, please reach out via our
						<a href="/contact">contact page</a>.
					</p>
				</div>
			</div>
		</main>

</Layout>
