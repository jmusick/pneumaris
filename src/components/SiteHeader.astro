---
import { Icon } from "astro-icon/components";

interface Props {
	active?: "home" | "music" | "about" | "extras" | "contact";
}

const { active } = Astro.props;

const socials = [
	{
		label: "Spotify",
		href: "https://open.spotify.com/artist/0LwtEDzdDXRarZ1H4eLqnU",
		icon: "simple-icons:spotify",
	},
	{
		label: "Apple Music",
		href: "https://music.apple.com/us/artist/pneumaris/1896511324",
		icon: "simple-icons:applemusic",
	},
	{
		label: "SoundCloud",
		href: "https://soundcloud.com/pneumaris",
		icon: "simple-icons:soundcloud",
	},
	{
		label: "YouTube",
		href: "https://www.youtube.com/@Pneumaris",
		icon: "simple-icons:youtube",
	},
	{
		label: "TikTok",
		href: "https://www.tiktok.com/@pneumaris",
		icon: "simple-icons:tiktok",
	},
	{
		label: "Twitter / X",
		href: "https://x.com/pneumarisband",
		icon: "simple-icons:x",
	},
	{
		label: "Instagram",
		href: "https://www.instagram.com/pneumaris/",
		icon: "simple-icons:instagram",
	},
	{
		label: "Facebook",
		href: "https://www.facebook.com/profile.php?id=61589446647657",
		icon: "simple-icons:facebook",
	},
];
---

<header class="site-head">
	<div class="site-head-inner">
		<a href="/" class="brand-link">
			<img
				class="brand-logo"
				src="/logo-circle.webp"
				width="640"
				height="640"
				alt=""
				loading="eager"
				decoding="async"
			/>
			<span class="brand-name">Pneumaris</span>
		</a>

		<button
			type="button"
			class="nav-toggle"
			aria-expanded="false"
			aria-controls="site-menu"
			aria-label="Toggle menu"
		>
			<Icon name="lucide:menu" class="nav-toggle-icon-open" aria-hidden="true" />
			<Icon name="lucide:x" class="nav-toggle-icon-close" aria-hidden="true" />
		</button>

		<div class="site-head-right" id="site-menu">
			<nav class="site-nav" aria-label="Primary">
				<a class={active === "home" ? "active" : undefined} aria-current={active === "home" ? "page" : undefined} href="/">Home</a>
				<a class={active === "music" ? "active" : undefined} aria-current={active === "music" ? "page" : undefined} href="/music/">Music</a>
				<a class={active === "about" ? "active" : undefined} aria-current={active === "about" ? "page" : undefined} href="/about/">About</a>
				<a class={active === "extras" ? "active" : undefined} aria-current={active === "extras" ? "page" : undefined} href="/extras/">Extras</a>
				<a
					href="https://www.etsy.com/shop/EgamiDesigns?section_id=59398309"
					target="_blank"
					rel="noopener noreferrer"
				>
					Merch
				</a>
				<a class={active === "contact" ? "active" : undefined} aria-current={active === "contact" ? "page" : undefined} href="/contact/">Contact</a>
			</nav>

			<div class="site-head-divider" aria-hidden="true"></div>

			<nav class="social-nav" aria-label="Social media">
				{socials.map((s) => (
					<a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} class="social-link">
						<Icon name={s.icon} aria-hidden="true" />
					</a>
				))}
			</nav>
		</div>
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
	const menu = document.getElementById("site-menu");

	if (toggle && menu) {
		const mobile = matchMedia("(max-width: 1100px)");
		const closeMenu = () => {
			menu.classList.remove("is-open");
			toggle.classList.remove("is-open");
			toggle.setAttribute("aria-expanded", "false");
			menu.inert = mobile.matches;
		};
		mobile.addEventListener("change", closeMenu);
		closeMenu();
		toggle.addEventListener("click", () => {
			const isOpen = menu.classList.toggle("is-open");
			menu.inert = mobile.matches && !isOpen;
			toggle.classList.toggle("is-open", isOpen);
			toggle.setAttribute("aria-expanded", String(isOpen));
		});

		menu.addEventListener("click", (event) => {
			if (event.target instanceof HTMLElement && event.target.closest("a")) {
				closeMenu();
			}
		});
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && menu.classList.contains("is-open")) {
				closeMenu();
				toggle.focus();
			}
		});
	}
</script>
