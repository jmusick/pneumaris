---
/**
 * Cookie consent banner for Google Analytics.
 *
 * Opt-in, and strictly so: gtag.js is not fetched at all until the visitor
 * accepts. A banner that loads the tag first and asks second still discloses the
 * visitor's IP to Google on page one, which is the thing consent is supposed to
 * prevent — so the script element is created only in the accept path.
 *
 * The choice lives in localStorage, not a cookie, so recording "no" doesn't
 * itself store anything a consent regime would object to.
 *
 * `measurementId` is null in dev (see ANALYTICS_ID in src/config/site.ts): the
 * banner still renders and behaves normally, it just has nothing to load.
 */
interface Props {
	measurementId: string | null;
}

const { measurementId } = Astro.props;
---

<div
	id="cookie-consent"
	class="cookie-consent"
	role="dialog"
	aria-modal="false"
	aria-labelledby="cc-title"
	aria-describedby="cc-body"
	hidden
>
	<div class="cc-inner">
		<div class="cc-text">
			<p id="cc-title" class="cc-title">Analytics</p>
			<p id="cc-body" class="cc-body">
				This site would like to count visits with Google Analytics, which sets cookies.
				Nothing is sent to Google unless you accept, and the site works the same either
				way. See the <a href="/privacy-policy/">privacy policy</a>.
			</p>
		</div>
		<div class="cc-actions">
			<button type="button" class="cc-btn cc-btn-ghost" data-consent="denied">Decline</button>
			<button type="button" class="cc-btn cc-btn-primary" data-consent="granted">Accept</button>
		</div>
	</div>
</div>

<script is:inline define:vars={{ measurementId }}>
	(function () {
		var STORAGE_KEY = "pneumaris-analytics-consent";
		var banner = document.getElementById("cookie-consent");
		if (!banner) return;

		var stored = null;
		try {
			stored = localStorage.getItem(STORAGE_KEY);
		} catch (e) {
			// Private-browsing modes can throw on access; treat as "no choice yet".
		}

		window.dataLayer = window.dataLayer || [];
		function gtag() {
			dataLayer.push(arguments);
		}

		var loaded = false;
		function loadAnalytics() {
			if (loaded || !measurementId) return;
			loaded = true;

			// Consent Mode defaults are declared before config so the tag never
			// assumes permission for anything beyond the analytics storage granted here.
			gtag("consent", "default", {
				ad_storage: "denied",
				ad_user_data: "denied",
				ad_personalization: "denied",
				analytics_storage: "denied",
			});
			gtag("consent", "update", { analytics_storage: "granted" });
			gtag("js", new Date());
			gtag("config", measurementId);

			var script = document.createElement("script");
			script.async = true;
			script.src = "https://www.googletagmanager.com/gtag/js?id=" + measurementId;
			document.head.appendChild(script);
		}

		/** Withdrawing consent can't unload a running tag — drop its cookies and reload. */
		function clearAnalyticsCookies() {
			var host = location.hostname;
			document.cookie.split(";").forEach(function (entry) {
				var name = entry.split("=")[0].trim();
				if (name.indexOf("_ga") !== 0) return;
				var expiry = "=; Max-Age=0; path=/";
				document.cookie = name + expiry;
				document.cookie = name + expiry + "; domain=" + host;
				document.cookie = name + expiry + "; domain=." + host;
			});
		}

		function show() {
			banner.hidden = false;
		}

		function record(choice) {
			var wasGranted = stored === "granted";
			stored = choice;
			try {
				localStorage.setItem(STORAGE_KEY, choice);
			} catch (e) {
				// Choice won't persist, but honour it for this page view.
			}
			banner.hidden = true;

			if (choice === "granted") {
				loadAnalytics();
			} else if (wasGranted) {
				clearAnalyticsCookies();
				location.reload();
			}
		}

		if (stored === "granted") {
			loadAnalytics();
		} else if (stored !== "denied") {
			show();
		}

		banner.addEventListener("click", function (event) {
			var button = event.target.closest("[data-consent]");
			if (button) record(button.getAttribute("data-consent"));
		});

		// Any element with data-cookie-preferences reopens the choice — the footer
		// link uses this, and it satisfies "consent must be as easy to withdraw".
		document.addEventListener("click", function (event) {
			var trigger = event.target.closest("[data-cookie-preferences]");
			if (!trigger) return;
			event.preventDefault();
			show();
			banner.querySelector("[data-consent]").focus();
		});
	})();
</script>

<style>
	.cookie-consent {
		position: fixed;
		z-index: 60;
		left: 1rem;
		right: 1rem;
		bottom: 1rem;
		background: var(--surface-strong);
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
		padding: 1.2rem 1.5rem;
	}

	.cookie-consent[hidden] {
		display: none;
	}

	.cc-inner {
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.cc-text {
		flex: 1 1 340px;
	}

	.cc-title {
		font-family: "Cinzel", serif;
		font-size: 0.78rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--gold-bright);
		margin: 0 0 0.35rem 0;
	}

	.cc-body {
		font-family: "Raleway", sans-serif;
		font-size: 0.88rem;
		line-height: 1.55;
		color: var(--ink-soft);
		margin: 0;
	}

	.cc-actions {
		display: flex;
		gap: 0.75rem;
		flex-shrink: 0;
	}

	.cc-btn {
		border-radius: 0.35rem;
		padding: 0.6rem 1.1rem;
		font-family: "Cinzel", serif;
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		cursor: pointer;
		transition: background 180ms ease, border-color 180ms ease;
	}

	.cc-btn-ghost {
		background: transparent;
		border: 1px solid var(--line);
		color: var(--ink-soft);
	}

	.cc-btn-ghost:hover {
		border-color: var(--gold-dim);
		color: var(--ink);
	}

	.cc-btn-primary {
		background: rgba(184, 154, 106, 0.12);
		border: 1px solid var(--gold-dim);
		color: var(--gold-bright);
	}

	.cc-btn-primary:hover {
		background: rgba(184, 154, 106, 0.2);
		border-color: var(--gold);
	}

	@media (max-width: 640px) {
		.cc-actions {
			width: 100%;
		}

		.cc-actions .cc-btn {
			flex: 1;
		}
	}
</style>
